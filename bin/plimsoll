#!/usr/bin/env zsh
# plimsoll — subcommand dispatcher.
#
# The repo drives everything through `make`, which is fine in a checkout but
# useless once Homebrew has installed the scripts into libexec. This is the
# installed entry point; `make` targets simply call the same scripts directly.

emulate -L zsh
setopt no_err_return

local here=${0:A:h}
# Homebrew installs the scripts into libexec and symlinks this file into bin, so
# resolve through the symlink (${0:A}) and look for the scripts beside us.
[[ -d $here/lib ]] || here=${0:A:h:h}/libexec

local -A CMDS=(
  report        "disk-report.zsh"
  check         "disk-guard.zsh"
  reclaim       "reclaim.zsh"
  docker        "docker-reclaim.zsh"
  tm-exclude    "tm-exclude.zsh"
)

usage() {
  print -r -- "plimsoll — macOS disk triage toolkit"
  print -r -- ""
  print -r -- "usage: plimsoll <command> [options]"
  print -r -- ""
  print -r -- "  report        full read-only diagnostic, ending in a verdict"
  print -r -- "  check         run the health guard once (exit 0 ok / 1 warn / 2 crit)"
  print -r -- "  reclaim       tiered disk reclamation          (dry-run by default)"
  print -r -- "  docker        Docker space, never touches volumes (dry-run by default)"
  print -r -- "  tm-exclude    apply the Time Machine exclusion policy (dry-run by default)"
  print -r -- "  thin          release space held by local Time Machine snapshots"
  print -r -- "  install-guard install the launchd watchdog (checks every 2h)"
  print -r -- "  uninstall-guard"
  print -r -- "  guard-status  show whether the launchd watchdog is loaded"
  print -r -- "  version"
  print -r -- ""
  print -r -- "Every destructive command needs --apply. Pass --help to any of them."
}

local cmd=${1:-}
(( $# )) && shift

case $cmd in
  ""|-h|--help|help) usage ;;
  version|-v|--version)
    # pl_version owns the three-source resolution; this and the SwiftBar About
    # submenu used to carry their own copy of the sed, which is how they could
    # have disagreed.
    source $here/lib/common.zsh 2>/dev/null
    print -r -- "plimsoll $(pl_version ${0:A})" ;;
  thin)
    # Space that deletions did not return is usually held by local snapshots.
    # This is the one operation people most often need and least often know
    # about, so it explains itself before doing anything.
    local n=0
    source $here/lib/common.zsh 2>/dev/null && n=$(pl_snapshot_count)
    print -r -- "Local Time Machine snapshots on this Mac: ${n}"
    print -r -- ""
    print -r -- "These hold on to blocks from files you have deleted. Until they are"
    print -r -- "thinned, deleting more frees nothing. Thinning removes LOCAL snapshots"
    print -r -- "only — backups on your Time Machine destination are untouched."
    print -r -- ""
    (( n == 0 )) && { print -r -- "Nothing to thin."; exit 0 }

    # A backup in progress is reading from one of these snapshots, and this runs
    # at the highest urgency with "free as much as possible". `man tmutil` makes
    # no promise about a snapshot that is in use, so treat the running backup as
    # the thing at risk. Nothing on the destination can be harmed either way --
    # what you lose is the run in flight, which is the expensive part when a
    # chain has been failing and one attempt has finally started to land.
    if pl_tm_running; then
      local prog=$(pl_tm_progress_pct)
      print -r -- ""
      print -r -- "A backup is RUNNING right now$( [[ -n $prog ]] && print -n " (${prog}%)" )."
      print -r -- "Thinning these snapshots while it reads from them will most likely abort"
      print -r -- "it. Your existing backups are not at risk — only the run in progress."
      print -r -- "Let it finish first; thinning takes seconds and will still be there."
      if [[ -z ${PL_ALLOW_DURING_BACKUP:-} ]]; then
        print -r -- ""
        print -r -- "Refusing. Set PL_ALLOW_DURING_BACKUP=1 to override."
        exit 1
      fi
    fi
    # A confirmation prompt should be readable; 21 snapshot names are not.
    print -r -- "  oldest: $(pl_snapshot_list | head -1)"
    print -r -- "  newest: $(pl_snapshot_list | tail -1)"
    print -r -- ""
    print -r -- "Deletes all but the NEWEST snapshot, one at a time:"
    print -r -- "      sudo tmutil deletelocalsnapshots <date>"
    print -r -- "The newest is kept because Time Machine uses it as the baseline for"
    print -r -- "its next incremental; older ones pin the most deleted data anyway."
    print -r -- "PL_THIN_ALL=1 removes every snapshot instead, baseline included."
    print -r -- ""
    # Shell startup can be noisy — an oh-my-zsh update prompt, a version-manager
    # notice — and anything left in the input buffer gets eaten by the next read,
    # which silently answers this question for you. Drain first, and read from
    # the terminal directly rather than whatever stdin happens to be.
    unsetopt correct correct_all 2>/dev/null
    print -r -- ""
    printf 'Thin them now? [y/N] '
    # `[[ -r /dev/tty ]]` is true even where the device cannot actually be
    # opened, so attempt the open rather than test the path.
    if { : </dev/tty } 2>/dev/null; then
      while read -t 0.05 -k 1 -s </dev/tty 2>/dev/null; do : ; done
      read -r reply </dev/tty
    else
      read -r reply            # piped or scripted: no tty to drain
    fi
    [[ $reply == [yY]* ]] || { print -r -- "Cancelled."; exit 0 }

    local before=$(pl_free_bytes)
    # Through the shared helper, not a second copy of the command. The inline
    # version here silently missed the change that made thinning keep Time
    # Machine's baseline, exactly as an inline copy of the progress-percent
    # expression missed its fix.
    pl_thin_snapshots
    local after=$(pl_free_bytes)
    print -r -- ""
    if [[ -n $before && -n $after ]]; then
      print -r -- "Reclaimed $(pl_human $(( after - before ))). Snapshots now: $(pl_snapshot_count)."
    else
      print -r -- "Thinned. Free space could not be measured, so the amount reclaimed is unknown. Snapshots now: $(pl_snapshot_count)."
    fi

    # The menu bar caches its last render for the plugin's interval, so without
    # this the warning persists for up to ten minutes after it stops being true.
    # -g keeps focus in this window.
    open -g "swiftbar://refreshplugin?name=plimsoll" 2>/dev/null
    ;;
  install-guard)
    local plist=$HOME/Library/LaunchAgents/com.plimsoll.diskguard.plist
    # Before anything loads: clear a sparkling-clean install if one is still
    # here. Two guards on one machine notify twice and split their de-dup state.
    source $here/lib/common.zsh 2>/dev/null && pl_migrate_legacy
    mkdir -p ${plist:h}
    # Checkout layout puts launchd/ beside bin/; Homebrew installs it inside
    # libexec alongside the scripts. Look in both.
    local tmpl
    for tmpl in $here/launchd/com.plimsoll.diskguard.plist \
                $here/../launchd/com.plimsoll.diskguard.plist; do
      [[ -r $tmpl ]] && break
    done
    [[ -r $tmpl ]] || { print -ru2 -- "plist template not found"; exit 1 }
    sed "s|__PL_ROOT__|${here:h}|g" $tmpl > $plist
    launchctl unload $plist 2>/dev/null
    launchctl load  $plist && print -r -- "loaded — checks every 2h, notifies on WARN/CRIT" ;;
  uninstall-guard)
    local plist=$HOME/Library/LaunchAgents/com.plimsoll.diskguard.plist
    launchctl unload $plist 2>/dev/null
    rm -f $plist && print -r -- "removed" ;;
  guard-status)
    launchctl list | grep com.plimsoll.diskguard || print -r -- "not loaded (plimsoll install-guard)" ;;
  *)
    local script=${CMDS[$cmd]:-}
    if [[ -z $script ]]; then
      print -ru2 -- "plimsoll: unknown command '$cmd'"
      print -ru2 -- "try: plimsoll --help"
      exit 2
    fi
    exec zsh $here/$script "$@" ;;
esac
