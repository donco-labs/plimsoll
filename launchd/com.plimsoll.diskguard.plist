<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for plimsoll's disk guard.

  Installed to ~/Library/LaunchAgents/ by `make install-guard`, which rewrites
  __PL_ROOT__ to this repo's absolute path. Do not load this file in place.

  Why launchd and not cron: launchd runs a missed interval on wake, so a laptop
  that was asleep at the scheduled time still gets checked. cron silently skips.
  It also runs inside the user's GUI session, which `display notification` needs.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.plimsoll.diskguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__PL_ROOT__/bin/disk-guard.zsh</string>
    </array>

    <!-- Every 2 hours. Cheap: a few diskutil/find calls, well under a second. -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <!-- Also check shortly after login, when yesterday's creep is news. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PL_ROOT__/.guard.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PL_ROOT__/.guard.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
